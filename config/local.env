# =====================================================================
# OmniRoute kit — local configuration
# setup.ps1 reads this file. Keep it private: it contains live API keys.
# =====================================================================

# Gateway port (pinned by the launcher; the package default is 58342)
OMNIROUTE_PORT=20128

# Dashboard password (OmniRoute's default is CHANGEME — change it in the
# dashboard after first login: http://localhost:20128/admin)
DASHBOARD_PASSWORD=CHANGEME

# NVIDIA NIM free API key (https://build.nvidia.com -> "Get API Key")
NVIDIA_NIM_API_KEY=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

# OpenCode Zen free API key (https://opencode.ai/zen)
OPENCODE_ZEN_API_KEY=sk-tatJP51OVcJ60Zz2Lr3y21Ts3IYZjCOVC3ku1UfAWSe4IgoIdB8LrTRWwgKB0iIb

# GitLab Duo OAuth - free Claude Sonnet 4.6 / Haiku 4.5 via GitLab.com free tier.
# 1) gitlab.com -> Preferences -> Applications -> New application
#    Redirect URI: http://localhost:20128/callback
#    Scopes: ai_features, read_user   |   Confidential: OFF (PKCE, no secret needed)
# 2) Paste the Application ID below, then add GITLAB_DUO_OAUTH_CLIENT_ID=<id> to
#    ~/.omniroute/.env and restart the gateway.
GITLAB_DUO_OAUTH_CLIENT_ID=

GEMINI_API_KEY=AQ.Ab8RN6I8oEIAgA_dxegRk_48WHP9h4hPStglcJKy9TC4Kl7-qw
