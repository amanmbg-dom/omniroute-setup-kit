# =====================================================================
# OmniRoute kit — local configuration
# setup.ps1 reads this file. Keep it private: it contains live API keys.
# =====================================================================

# Gateway port (pinned by the launcher; the package default is 58342)
OMNIROUTE_PORT=20128

# Dashboard password (OmniRoute's default is CHANGEME — change it in the
# dashboard after first login: http://localhost:20128/admin)
DASHBOARD_PASSWORD=CHANGEME

# NVIDIA NIM free API key (https://build.nvidia.com -> "Get API Key")
NVIDIA_NIM_API_KEY=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

# OpenCode Zen free API key (https://opencode.ai/zen)
OPENCODE_ZEN_API_KEY=sk-tatJP51OVcJ60Zz2Lr3y21Ts3IYZjCOVC3ku1UfAWSe4IgoIdB8LrTRWwgKB0iIb

# GitLab Duo OAuth - free Claude Sonnet 4.6 / Haiku 4.5 via GitLab.com free tier.
# 1) gitlab.com -> Preferences -> Applications -> New application
#    Redirect URI: http://localhost:20128/callback
#    Scopes: ai_features, read_user   |   Confidential: OFF (PKCE, no secret needed)
# 2) Paste the Application ID below, then add GITLAB_DUO_OAUTH_CLIENT_ID=<id> to
#    ~/.omniroute/.env and restart the gateway.
GITLAB_DUO_OAUTH_CLIENT_ID=

GEMINI_API_KEY=AQ.Ab8RN6I8oEIAgA_dxegRk_48WHP9h4hPStglcJKy9TC4Kl7-qw

# ---------------------------------------------------------------------
# freellm.net free-tier providers (all OpenAI-compatible).
# Fill in a key and re-run setup.ps1 to wire the provider in. Blank = skipped.
# Get keys: https://freellm.net/free-llm-api-keys/
# ---------------------------------------------------------------------

# Groq - no credit card, 30 RPM free (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter - free tier + $10 one-time topup -> ~1K requests/day, :free models
# (https://openrouter.ai/keys). Free models appear as openrouter/<model>:free.
OPENROUTER_API_KEY=

# GitHub Models - no credit card (https://github.com/settings/tokens?type=beta)
GITHUB_MODELS_API_KEY=

# Cloudflare Workers AI - no credit card, 10K neurons/day (dashboard.cloudflare.com)
# The API token alone is NOT enough: paste your Account ID too (dash.cloudflare.com,
# right sidebar under "Account ID"). Required for every request (502 without it).
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ModelScope - registration, 2K RPD (https://modelscope.cn)
MODELSCOPE_API_KEY=

# LLM7.io - no credit card (https://llm7.io)
LLM7_API_KEY=

# OVHcloud AI Endpoints - registration (https://endpoints.ai.cloud.ovh.net)
OVHCLOUD_API_KEY=

# Ollama Cloud - registration (https://ollama.com)
OLLAMA_API_KEY=

# SambaNova - registration (https://cloud.sambanova.ai)
SAMBANOVA_API_KEY=

# Aion Labs - registration (https://aionlabs.ai)
AION_API_KEY=

# Agnes AI - registration (https://agnes-ai.com)
AGNES_API_KEY=

# Chutes.ai - registration (https://chutes.ai)
CHUTES_API_KEY=

# AI21 Labs - registration (https://www.ai21.com)
AI21_API_KEY=

# Nscale - registration (https://nscale.com)
NSCALE_API_KEY=

# Alibaba Cloud Model Studio - registration (https://www.alibabacloud.com/product/model-studio)
ALIBABA_API_KEY=

# Z AI (Zhipu) - no credit card (https://open.bigmodel.cn)
ZAI_API_KEY=

# Mistral AI - no credit card (https://console.mistral.ai)
MISTRAL_API_KEY=

# Cohere - no credit card (https://dashboard.cohere.com)
COHERE_API_KEY=

# Cerebras - no credit card (https://console.cerebras.ai)
CEREBRAS_API_KEY=

# Hugging Face - no credit card (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# DeepSeek - registration (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# xAI (Grok) - registration, credit-based (https://console.x.ai)
XAI_API_KEY=

# Nebius - registration (https://studio.nebius.com)
NEBIUS_API_KEY=

# SiliconFlow - registration (https://siliconflow.cn)
SILICONFLOW_API_KEY=

# ── Performance Tuning ──
# Faster upstream fetch timeout (default 120s is way too long for fast failover)
OMNIROUTE_DEFAULT_FETCH_TIMEOUT_MS=30000

# Faster provider cooldown recovery (default 5min max is too long)
PROVIDER_COOLDOWN_MIN_MS=2000
PROVIDER_COOLDOWN_MAX_MS=30000

# Faster rate-limit queue bail (default 15s)
RATE_LIMIT_MAX_WAIT_MS=10000

# Stream recovery for mid-stream failures
STREAM_RECOVERY_ENABLED=true
STREAM_RECOVERY_MIDSTREAM_ENABLED=true

# Cap concurrent in-flight connections to prevent memory bloat
OMNI_MAX_CONCURRENT_CONNECTIONS=50
